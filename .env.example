# Qdrant vector database endpoint
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=knowledge_base
# Set this whenever Qdrant is reachable beyond the container network.
QDRANT_API_KEY=

# Frappe backend base URL
FRAPPE_URL=http://localhost:8000
FRAPPE_AUTH_TOKEN=token 02672xxxxxxxxxx:dff90xxxxxxxxxx

# Shared key required by EVERY endpoint except /health.
# Must match `retrieval_api_key` in the Frappe site config.
RETRIEVAL_API_KEY=

# Logging
LOG_LEVEL=info
# Chat bodies can contain member questions; keep off outside debugging.
LOG_CHAT_REQUEST_BODY=false

# OpenAI-compatible
OPENAI_API_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Embedding via endpoint OpenAI-compatible (mis. OpenRouter: https://openrouter.ai/api/v1).
# URL tanpa path otomatis diberi akhiran /v1.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Satu kalimat tentang cakupan asisten ini. Dibaca hanya oleh step triage,
# yang butuh gambaran "di dalam konteks" untuk membedakan basa-basi dari
# pertanyaan di luar cakupan. Dikosongkan, triage menyimpulkan cakupan dari
# katalog tool MCP dan kutipan FAQ.
ASSISTANT_SCOPE=

# Outbound timeouts (ms) and LLM retry budget
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_MAX_RETRIES=2
FRAPPE_TIMEOUT_MS=30000
QDRANT_TIMEOUT_MS=10000

# Ceiling on one whole /chat, across every LLM, MCP and embedding call it makes.
# The per-call timeouts above do not bound the flow: six sequential LLM calls,
# each retried, multiply out past any caller's own timeout. Keep this below the
# caller's timeout (90s in Frappe): above it, the caller has already given up
# while this side keeps paying for an answer nobody will read.
CHAT_DEADLINE_MS=75000

# Texts per embeddings request, and per progress update during a FAQ reindex.
EMBEDDING_BATCH_SIZE=64

# Background /chat/async jobs. Each spends three to six paid LLM calls, so a
# burst without a ceiling fans out into hundreds of concurrent calls. Jobs past
# MAX_CONCURRENT wait; jobs past MAX_QUEUED are refused with 503.
CHAT_ASYNC_MAX_CONCURRENT=8
CHAT_ASYNC_MAX_QUEUED=64

# Provider features not every OpenAI-compatible backend implements. "auto"
# probes once and remembers a rejection for the life of the process, "on"
# requires the feature, "off" never attempts it.
#   LLM_NATIVE_TOOLS  provider-parsed tool calls vs. the JSON planner fallback
#   LLM_JSON_SCHEMA   Structured Outputs (response_format json_schema, strict)
LLM_NATIVE_TOOLS=auto
LLM_JSON_SCHEMA=auto

# Safety stop for MCP tools/list pagination.
MCP_MAX_TOOL_PAGES=20

# Abuse limits. The rate-limit bucket is the end user (`actor`), falling back to
# the client address. The store is in-process, so with N replicas the effective
# ceiling is RATE_LIMIT_MAX * N per user.
#
# The FAQ sync paths (/faq/*, except /faq/generate) carry no actor and get their
# own, larger budget: they are driven by Frappe doc_events, so one bulk import
# legitimately writes every row it touches within a minute.
MAX_BODY_BYTES=1048576
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
FAQ_RATE_LIMIT_MAX=600

# Read X-Forwarded-For as the client address. Only enable behind a proxy that
# overwrites it: otherwise a client can forge its own rate-limit bucket.
TRUST_PROXY=false
